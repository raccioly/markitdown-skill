{
  "$schema": "https://raccioly.github.io/docguard/schemas/docguard-config.schema.json",
  "projectName": "markitdown-skill",
  "version": "0.5",
  "profile": "starter",
  "projectType": "library",
  "projectTypeConfig": {
    "needsEnvVars": false,
    "needsEnvExample": false,
    "needsE2E": false,
    "needsDatabase": false
  },
  "requiredFiles": {
    "canonical": [
      "docs-canonical/ARCHITECTURE.md",
      "docs-canonical/DATA-MODEL.md",
      "docs-canonical/SECURITY.md",
      "docs-canonical/TEST-SPEC.md",
      "docs-canonical/ENVIRONMENT.md",
      "docs-canonical/REQUIREMENTS.md"
    ]
  },
  "validators": {
    "structure": true,
    "docsSync": true,
    "drift": false,
    "changelog": true,
    "architecture": false,
    "testSpec": false,
    "security": false,
    "environment": false,
    "freshness": false
  },
  "personnel": {}
}
